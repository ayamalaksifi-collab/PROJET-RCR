      "authority": "to_be_verified_from_source_registry",
      "page_start": 2,
      "page_end": 2,
      "section": "4.3. Contre-indications",
      "text": "4.3. Contre-indications\nHypersensibilité à l'énalapril, à l'un des constituants ou à tout autre IEC.\nAntécédent d'angio-œdème lié à un traitement antérieur par un IEC.\nAngio-œdème héréditaire ou idiopathique.\n2ème et 3ème trimestres de la grossesse.",
      "verification_status": "extracted_not_manually_verified"
    },
    {
      "passage_id": "RCP-M031-RCP_ENALAPRIL-16baa36823-009-01",
      "source_document_id": "RCP_ENALAPRIL-16baa36823",
      "medicine_id": "M031",
      "standardized_dci": "énalapril",
      "source_pdf": "Pharmeazor/documents/Enalapril/raw/RCP- ENALAPRIL.pdf",
